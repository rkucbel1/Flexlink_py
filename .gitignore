# Python and the virtual environment
.venv/
__pycache__/
*.pyc
*.egg-info/

# Private or third-party documents: check before publishing
Docs/Password*.txt
Docs/*.pdf

# Logs
*.log

# Outputs of simulation runs (recreated by Initialize_Tx/Rx.py and the Tx/Rx chains)
/Tx/*.h5
/Tx/ControlSignals/*.h5
/Tx/Generate_RandomPacketOfData/*.h5
/Rx/*.h5
App/Sweeps/
App/HIL/

# File transfer: received files, partly received state, worker copies, test files
Rx/FileTransfer_State/
Rx/Received_Files/
App/FileTransfer_Workers/
App/Test_Files_For_Transfer/

# CoreBoard (ESP32-S31) captures and processing outputs, recreated by
# FlexlinkCaptureWithCoreBoard.py / FlexlinkProcessCoreBoardCapturedWaveform.py.
# Captures are hundreds of MB (GitHub refuses files over 100 MB); one 8 MB segment is kept
# as a known-good test signal for the emulator and the processing script.
App/CoreBoard/*.cs8
!App/CoreBoard/Segment_newfw_3820ms.cs8
App/CoreBoard/*.zip
App/CoreBoard/EmuSource.json
App/CoreBoard/CoreBoard_Capture.json
App/CoreBoard/CoreBoard_Packet_Rx.h5
App/CoreBoard/CoreBoard_Packets.csv
App/CoreBoard/CoreBoard_Results.txt
App/CoreBoard/Channel_Defects_Off.json
App/CoreBoard/All_*.txt
App/CoreBoard/FileTransfer_State/
App/CoreBoard/Received_Files/

# Pluto loopback outputs (FlexlinkTxWithPluto.py)
App/Pluto/

# FPGA development (HW_Development). Formerly in Packet_Detector/.gitignore and
# Packet_Transmitter/.gitignore; this is now the only .gitignore of the repository.
# Vivado / Vitis everywhere
.Xil/
*.jou

# Packet_Detector (CoreBoard receiver)
HW_Development/Packet_Detector/HW/build/
HW_Development/Packet_Detector/FW/workspace/
HW_Development/Packet_Detector/FW/debug/
HW_Development/Packet_Detector/SIM/work/
HW_Development/Packet_Detector/SIM/cosim/obj/
HW_Development/Packet_Detector/SIM/cosim/*.o
HW_Development/Packet_Detector/TestVectors/*_result.json
HW_Development/Packet_Detector/TestVectors/*_debug.png

# Packet_Detector_FCOMM (FMCOMMS3 receiver), recreated by HW/build_hw_fmcomms3.tcl
HW_Development/Packet_Detector_FCOMM/HW/build_fmcomms3/

# Packet_Transmitter (Pluto)
HW_Development/Packet_Transmitter/HW/build/
HW_Development/Packet_Transmitter/SIM/work/
HW_Development/Packet_Transmitter/PC/*.npz
!HW_Development/Packet_Transmitter/PC/ptx_tables.npz
HW_Development/Packet_Transmitter/PC/*_40.bin
HW_Development/Packet_Transmitter/PC/cap*.json
HW_Development/Packet_Transmitter/PC/model_vector*.json
HW_Development/Packet_Transmitter/FW/ptx_server
HW_Development/Packet_Transmitter/FW/ptx_server_stub
HW_Development/Packet_Transmitter/FW/ptx_params_test
HW_Development/Packet_Transmitter/FW/ptx_stub_stream.bin

